<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Plain http only to this computer, for chan.apiBaseUrl in local.properties -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds report to Sentry as "debug", so emulator and dev-phone errors
             do not show up as "production" (the default when no environment is set). -->
        <meta-data android:name="io.sentry.environment" android:value="debug" />

        <!-- Debug builds only (this file is not merged into release).
             Shows every screen with sample data: no account, no network.
             Has its own launcher icon, "69chan previews". See PreviewActivity.kt for the adb command. -->
        <activity
            android:name="com.mycom.chan.preview.PreviewActivity"
            android:exported="true"
            android:label="69chan previews"
            android:taskAffinity="com.mycom.chan.preview"
            android:theme="@style/Theme._chan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
